FROM golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
ENV CGO_ENABLED=0
ARG VERSION=dev
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
# Empty spool directory owned by the runtime user; a named volume mounted
# there inherits this ownership.
RUN mkdir /spool && chown 65532:65532 /spool
# The value is quoted inside -ldflags, so a VERSION with spaces stays one -X value.
RUN go build -trimpath -ldflags="-s -w -X 'main.version=${VERSION}'" -o /out/geoint ./cmd/geoint

# Final image has no shell and runs as a non-root user.
FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=build /out/geoint /geoint
COPY --from=build --chown=65532:65532 /spool /spool
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/geoint"]
