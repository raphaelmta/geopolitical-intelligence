# Source simulator for the end-to-end test only (deploy/compose.e2e.yml):
# serves testdata/ as the five public sources. Never used by compose.yml.
# Build context: the repository root.
FROM golang:1.27.4-alpine3.24@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS build
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/sourcesim ./cmd/sourcesim

FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=build /out/sourcesim /sourcesim
COPY testdata /testdata
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/sourcesim"]
CMD ["-addr", ":8080", "-testdata", "/testdata"]
