# Local settings of the stack. `make up` creates .env from this file with
# scripts/init-env.sh, which replaces every change-me value with a new random
# secret (file mode 0600). The change-me values below are public placeholders:
# `make up` refuses to start while .env still contains one.
# Passwords must use only A-Z a-z 0-9 . _ ~ - (they go inside connection URLs).

# Database owner: used only by `geoint migrate` (make up / make migrate).
POSTGRES_USER=geoint
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=geoint

# Database roles of the worker (geoint_worker) and of the API (geoint_api),
# created by the migrations; `geoint migrate` sets these passwords at every run.
DB_WORKER_PASSWORD=change-me-db-worker
DB_API_PASSWORD=change-me-db-api

MINIO_ROOT_USER=geoint
MINIO_ROOT_PASSWORD=change-me-minio
S3_BUCKET=geoint

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Token verification by the api. These are set in deploy/compose.yml and listed
# here only for reference (the compose file does not read them from .env).
# OIDC_ISSUER is the iss tokens must carry (the public URL the browser uses);
# OIDC_DISCOVERY_URL is where the api fetches discovery and signing keys.
# OIDC_ISSUER=http://localhost:8081/realms/geoint
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/geoint
# OIDC_AUDIENCE=geoint-api

# Scheduler of the worker: empty or true keeps every source that was collected
# once up to date (it never starts a source's first collection); false leaves
# only manual requests (make collect, "Coletar agora").
# SCHEDULER_ENABLED=false

# Identity resolution: a name seen with more distinct CPF fragments than this
# goes to the identity queue instead of merging automatically. Empty: 100.
# IDENTITY_COMMON_NAME_THRESHOLD=

# Receita completeness rules (docs/sources/receita.md). Leave BOTH EMPTY. An
# explicit RECEITA_MIN_PARTS always overrides the part count of the last load:
# set it only when the Receita really publishes fewer parts (the worker logs a
# warning with the parts found and required). RECEITA_SETTLE_HOURS: how long
# the newest file of an edition must be untouched before it is loaded.
# RECEITA_MIN_PARTS=
# RECEITA_SETTLE_HOURS=

# The one browser origin the API allows (CORS). Empty: http://localhost:5173.
# WEB_ORIGIN=

# Host names accepted by the API besides the local ones (localhost, 127.0.0.1,
# api), comma-separated. Empty: only the local ones.
# API_ALLOWED_HOSTS=

# Source download locations, set in deploy/compose.yml for the worker. Empty
# means the official source (docs/sources/receita.md, docs/sources/tse.md,
# docs/sources/camara.md, docs/sources/senado.md, docs/sources/cvm.md).
# RECEITA_BASE_URL=
# TSE_BASE_URL=
# CAMARA_BASE_URL=
# SENADO_BASE_URL=
# CVM_BASE_URL=

# Free space (GB) below which `make up` warns; `make national-check` requires
# NATIONAL_DISK_MIN_GB before a national load.
# DISK_WARN_GB=200
# NATIONAL_DISK_MIN_GB=200

# PostgreSQL settings (deploy/TUNING.md). Empty: the profile of the reference
# machine (6 cores, 31 GB RAM, NVMe). For a 16 GB machine use:
# PG_SHARED_BUFFERS=4GB
# PG_EFFECTIVE_CACHE_SIZE=10GB
# PG_MAINTENANCE_WORK_MEM=1GB
# PG_WORK_MEM=32MB
# PG_MAX_WAL_SIZE=16GB
# PG_AUTOVACUUM_WORK_MEM=512MB
# PG_AUTOVACUUM_MAX_WORKERS=3
# PG_MAX_PARALLEL_WORKERS=4
# PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
# PG_MAX_PARALLEL_MAINTENANCE_WORKERS=2
# PG_SHM_SIZE=4g
# Other knobs: PG_CHECKPOINT_TIMEOUT (30min), PG_RANDOM_PAGE_COST (1.1),
# PG_EFFECTIVE_IO_CONCURRENCY (200), PG_MAX_WORKER_PROCESSES (8),
# PG_MAX_CONNECTIONS (60: worker 16 + api 10 + migrate/collect/backup).
